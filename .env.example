# Optional — only needed if you want to use the helper scripts in tools/.
# The workflow itself stores its credentials inside n8n.

N8N_BASE_URL=http://localhost:5678
N8N_API_KEY=paste-n8n-personal-api-key-here

# After importing, paste the workflow ID (from the URL bar) here so
# tools/sync_workflow.py can resolve it automatically.
N8N_LEGAL_AI_WORKFLOW_ID=
